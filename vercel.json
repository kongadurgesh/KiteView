{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/chart/([^/]+)", "dest": "/api/chart/[symbol].js?symbol=$1" },
    { "src": "/api/quote/([^/]+)", "dest": "/api/quote/[symbol].js?symbol=$1" },
    { "src": "/api/search", "dest": "/api/search.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
